# Copia este archivo como .env y llena los valores reales (el profe los comparte por privado)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"
MERCADO_PAGO_ACCESS_TOKEN="tu_access_token"
MERCADO_PAGO_PUBLIC_KEY="tu_public_key"
# Secreto de firma del webhook (Tus Integraciones → Webhooks). Sin él se aceptan
# notificaciones sin verificar la firma, pero el estado del pago siempre se
# consulta a la API de Mercado Pago.
MERCADO_PAGO_WEBHOOK_SECRET="tu_secreto_de_firma"
RESEND_API_KEY="tu_resend_api_key"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
